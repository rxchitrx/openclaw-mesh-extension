{
  "name": "@openclaw/mesh",
  "version": "2026.5.9",
  "description": "P2P distributed file sync between OpenClaw nodes",
  "repository": {
    "type": "git",
    "url": "https://github.com/rxchitrx/openclaw-mesh-extension"
  },
  "type": "module",
  "scripts": {
    "build": "tsc",
    "test:diff": "node scripts/test-diff.mjs",
    "test:patch": "node scripts/test-diff.mjs",
    "test:path-safety": "node scripts/test-path-safety.mjs",
    "test:protocol": "node scripts/test-protocol-validation.mjs",
    "test:capabilities": "node scripts/test-capability-registry.mjs",
    "test:advertise": "node scripts/test-advertise-tool.mjs",
    "test:capability-execution": "node scripts/test-capability-execution.mjs",
    "test:identity": "node scripts/test-peer-identity.mjs",
    "test:approval": "node scripts/test-approval-flow.mjs",
    "test:notifications": "node scripts/test-urgent-notifications.mjs",
    "test:symlink-safety": "node scripts/test-symlink-safety.mjs",
    "test:ignore-patterns": "node scripts/test-ignore-patterns.mjs",
    "test:persistence": "node scripts/test-persistence.mjs"
  },
  "dependencies": {
    "@homebridge/ciao": "^1.3.6",
    "avahi-dbus": "^0.1.0",
    "bonjour-service": "^1.3.0",
    "ws": "^8.18.1"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "typescript": "^6.0.3"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.5.5"
    },
    "install": {
      "minHostVersion": ">=2026.5.5"
    }
  }
}
