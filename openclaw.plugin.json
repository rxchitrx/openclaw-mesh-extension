{
  "id": "mesh",
  "name": "OpenClaw Mesh",
  "description": "P2P distributed file sync between OpenClaw nodes via mDNS discovery and WebSocket connections",
  "activation": {
    "onStartup": true
  },
  "contracts": {
    "tools": [
      "mesh_discover",
      "mesh_status",
      "mesh_broadcast",
      "mesh_sync"
    ]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": true
      },
      "nodeName": {
        "type": "string",
        "description": "Unique name for this mesh node"
      },
      "port": {
        "type": "number",
        "default": 18790,
        "description": "Port for P2P WebSocket connections"
      },
      "workspaceDir": {
        "type": "string",
        "description": "Directory to sync (defaults to OpenClaw workspace)"
      }
    }
  }
}
