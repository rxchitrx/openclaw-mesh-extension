{
  "id": "mesh",
  "name": "OpenClaw Mesh",
  "description": "P2P project file sharing between OpenClaw nodes — a local offline GitHub",
  "activation": {
    "onStartup": true
  },
  "contracts": {
    "tools": [
      "mesh_discover",
      "mesh_status",
      "mesh_broadcast",
      "mesh_sync",
      "mesh_track",
      "mesh_approve",
      "mesh_diff"
    ]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": true
      },
      "nodeName": {
        "type": "string",
        "description": "Unique name for this mesh node"
      },
      "port": {
        "type": "number",
        "default": 18790,
        "description": "Port for P2P WebSocket connections"
      },
      "trackDir": {
        "type": "string",
        "description": "Directory to track and sync with peers"
      }
    }
  }
}
