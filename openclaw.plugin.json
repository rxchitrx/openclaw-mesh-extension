{
  "id": "mesh",
  "name": "OpenClaw Mesh",
  "description": "P2P project file sharing between OpenClaw nodes — a local offline GitHub",
  "activation": {
    "onStartup": true
  },
  "contracts": {
    "tools": [
      "mesh_discover",
      "mesh_status",
      "mesh_broadcast",
      "mesh_sync",
      "mesh_track",
      "mesh_approve",
      "mesh_reject",
      "mesh_connections",
      "mesh_diff",
      "mesh_events",
      "mesh_ack"
    ]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": true
      },
      "nodeName": {
        "type": "string",
        "description": "Unique name for this mesh node"
      },
      "port": {
        "type": "number",
        "default": 18790,
        "description": "Port for P2P WebSocket connections"
      },
      "trackDir": {
        "type": "string",
        "description": "Directory to track and sync with peers"
      },
      "ignorePatterns": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "default": [],
        "description": "Additional regex patterns for files and directories the file watcher should ignore"
      },
      "capabilities": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "default": [],
        "description": "Flat capability tags advertised to mesh peers, such as has:xcode or can:ios-build"
      }
    }
  }
}
